# Postgres
POSTGRES_USER=rluser
POSTGRES_PASSWORD=rlpass
POSTGRES_DB=ratelimiter

# Go Core
REDIS_ADDR=redis:6379
POSTGRES_DSN=postgres://rluser:rlpass@postgres:5432/ratelimiter?sslmode=disable
CACHE_REFRESH_INTERVAL=30s

# FastAPI Admin
DATABASE_URL=postgresql+psycopg2://rluser:rlpass@postgres:5432/ratelimiter

# Grafana
GRAFANA_PASSWORD=admin
